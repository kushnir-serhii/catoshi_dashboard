# Required: Base URL for the CoinGecko REST API.
# Free public tier: https://api.coingecko.com/api/v3
# Pro/Demo tier: https://pro-api.coingecko.com/api/v3
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Optional: CoinGecko API key for higher rate limits.
# Use x-cg-pro-api-key for Pro plans, x-cg-demo-api-key for Demo plans.
# Leave empty to use the free public endpoint (no key needed).
COINGECKO_API_KEY=
NEXT_PUBLIC_USE_MOCK_DATA=true
CRYPTOPANIC_API_KEY=your_key_here
# Neon Postgres. Use the POOLED connection string — the host contains "-pooler".
# A direct endpoint will exhaust its connection limit under serverless concurrency.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon Postgres. Use the DIRECT (unpooled) connection string — no "-pooler" in the
# host. Needed for DDL/session-level operations (scripts/migrate.mjs, pg_dump in
# .github/workflows/backup.yml) that the pooler's transaction mode can mishandle.
# Also stored as a GitHub Actions repository secret for the weekly backup workflow.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Shared secret authenticating /api/collect; also stored as a GitHub Actions secret,
# and as the Vercel project's CRON_SECRET env var (Vercel auto-injects it as
# `Authorization: Bearer <value>` on its own native Cron Jobs calls — see vercel.json).
CRON_SECRET=generate_a_long_random_string
# Shared secret unlocking POST /api/projections/refresh (the "Reforecast" action,
# spec 019) and GET /api/admin/unlock, which sets the HttpOnly cookie carrying it.
# Unset means the refresh route answers 503 — refusing to run unauthenticated is
# the point; it must never fall back to "open".
ADMIN_SECRET=generate_a_long_random_string
#
# NOTE — COLLECT_ENDPOINT is intentionally NOT listed here. It is the deployed
# production URL that .github/workflows/collect.yml calls (e.g.
# https://catoshi.example.com/api/collect). The app itself never reads this
# value at runtime, so it does not belong in .env — it is configured ONLY as a
# GitHub Actions repository secret (Settings -> Secrets and variables -> Actions).
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
# The product's only background (unattended, cron-triggered) model call:
# classifyNews(), invoked hourly by GitHub Actions and daily by Vercel's cron,
# inside /api/collect. Set to false to pause it while testing alone —
# collection, ingest, and publish of already-classified items are unaffected;
# only new classification stops (spec 019). Default: true.
NEWS_CLASSIFY_ENABLED=true
